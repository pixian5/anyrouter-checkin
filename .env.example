# AnyRouter / AgentRouter 多账号配置
#
# 每个账号可独立指定 provider：
#   provider="anyrouter"  ->  anyrouter.top（默认）
#   provider="agentrouter"->  agentrouter.org 或备用域名 ps.air-outer.com
#
# 邮箱密码登录（推荐）:
# ANYROUTER_ACCOUNTS=[
#   {"name":"AnyRouter号1","provider":"anyrouter","email":"xxx@xx.com","password":"xxx"},
#   {"name":"AgentRouter号1","provider":"agentrouter","email":"yyy@yy.com","password":"yyy"}
# ]
#
# Session 登录（兼容旧版）:
# ANYROUTER_ACCOUNTS=[{"provider":"anyrouter","cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]
#
# 混合配置（邮箱密码优先，session 作为备选）:
# ANYROUTER_ACCOUNTS=[{"provider":"anyrouter","email":"your@email.com","password":"your_password","cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

ANYROUTER_ACCOUNTS=[{"provider":"anyrouter","email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]

# 调试模式：true 时保存登录截图、输出代理地址/api_user 等详细日志（默认 false）
# DEBUG_MODE=false
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser

# PROVIDERS 可按平台覆盖 domain / 接口路径等：
# PROVIDERS={"agentrouter":{"domain":"https://ps.air-outer.com"}}

# 可选：Playwright 无头模式，服务器建议保持默认或显式设为 true
# PLAYWRIGHT_HEADLESS=true
# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
