# 仅供旧入口 scripts/aicheckin.py 使用；当前外挂 runner 应使用根目录上游格式 .env.example。
# 每个账号配置成一个 JSON 对象，按 ACCOUNT_1、ACCOUNT_2 顺序编号，不可跳号。
# ACCOUNT_1={"name":"主账号","provider":"agentrouter","email":"your@email.com","password":"your_password","api_user":"你的api_user值"}
# ACCOUNT_2={"name":"备用账号","provider":"anyrouter","session":"你的session值","api_user":"你的api_user值"}
